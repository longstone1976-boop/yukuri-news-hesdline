# 実際の値はクラウドの「環境変数」画面に入力してください。
# このファイルをコピーして .env を作る場合も、.env は Git に入れないこと。

# PostgreSQL の接続文字列（Render では自動で入ります）
DATABASE_URL=postgres://user:password@host:5432/yukkuri_news
# ローカルのPostgreSQLなどSSLを使わない場合だけ false
DATABASE_SSL=true

# Gemini API キー（Google AI Studio で発行。サーバー側だけに置く）
GEMINI_API_KEY=
# 使うモデル（Google のモデル名が変わったらここだけ変更）
GEMINI_MODEL=gemini-3.5-flash
# Gemini 呼び出しの最小間隔（ミリ秒）。無料枠の回数制限に引っかかる場合は大きくする
GEMINI_MIN_INTERVAL_MS=4000

# ログイン画面のユーザー名とパスワード（管理者1人）
APP_USER=admin
APP_PASSWORD=

# true：サーバーの中で 6:00／11:55／16:00（日本時間）に自動収集
# false：自動収集を止める（Cron Job から npm run collect を実行する場合）
ENABLE_SCHEDULER=true
